// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id            String   @id @default(uuid())
  titleEn       String
  titleAr       String
  category      String   // ERP, WEB, MOBILE, AI, CLOUD
  clientName    String
  region        String
  imageUrl      String
  hasLiveDemo   Boolean  @default(false)
  liveDemoUrl   String?
  techStack     String[] // Array of technologies
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Review {
  id            String   @id @default(uuid())
  clientName    String
  role          String
  company       String
  location      String
  rating        Int      @default(5)
  reviewText    String
  hasVideo      Boolean  @default(false)
  videoUrl      String?
  verified      Boolean  @default(true)
  featured      Boolean  @default(false)
  techCategory  String?  @default("general") // 'dotnet', 'odoo', 'general'
  createdAt     DateTime @default(now())
}

model TeamMember {
  id           String    @id @default(uuid())
  email        String?   @unique
  password     String?
  roles        String[]  @default(["project_manager"]) // 'super_admin', 'admin', 'project_manager', 'marketing_manager', 'review_manager'
  name         String
  role         String    @default("Senior Systems Architect") // role title
  bio          String?
  linkedinUrl  String?   @default("https://www.linkedin.com/")
  avatarUrl    String?
  displayOrder Int       @default(0)
  createdAt    DateTime? @default(now())
  updatedAt    DateTime? @updatedAt
}
